# =====================================================================
# CLIENT-SIDE (vão pro browser — visíveis pra qualquer usuário)
# Devem ter o prefixo VITE_ pra serem expostas pelo Vite.
# Use APENAS chaves "anon" / públicas aqui.
# =====================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_APP_NAME=Leona Projetos

# Bunny CDN — Storage Zone
VITE_BUNNY_PULL_ZONE_ID=YOUR_PULL_ZONE_ID
VITE_BUNNY_STORAGE_URL=https://ny.storage.bunnycdn.com/YOUR_STORAGE_ZONE
VITE_BUNNY_ACCESS_KEY=YOUR_BUNNY_STORAGE_KEY
VITE_BUNNY_CDN_URL=https://YOUR_PULL_ZONE.b-cdn.net


# =====================================================================
# SERVER-SIDE (usadas pelas Vercel Functions em /api/*)
# NUNCA usar o prefixo VITE_ aqui — devem ficar só no servidor.
# Necessárias pra criar/gerenciar membros (operações admin).
# =====================================================================

# A própria URL do Supabase (mesma do VITE_SUPABASE_URL — duplicada porque
# código server-side não tem acesso a env vars com prefixo VITE_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon key (também duplicada — usada pelas funções pra validar JWTs do client)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service role key — DÁ ACESSO TOTAL AO BANCO. NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY


# =====================================================================
# OPCIONAL — só pra CLI/automações locais (não usado em runtime)
# =====================================================================

# Personal Access Token do Supabase (pra usar Management API / supabase CLI)
# SUPABASE_ACCESS_TOKEN=sbp_xxxxx

# Senha do banco Postgres (pra conexões diretas via psql)
# SUPABASE_DB_PASSWORD=xxxxx
