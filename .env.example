# =====================================================================
# CLIENT-SIDE (vão pro browser — visíveis pra qualquer usuário)
# Devem ter o prefixo VITE_ pra serem expostas pelo Vite.
# Use APENAS chaves "anon" / públicas aqui.
# =====================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_APP_NAME=Leona Projetos


# =====================================================================
# SERVER-SIDE (Vercel Functions /api/*) — SEM prefixo VITE_
# NUNCA exponha estas no client.
# =====================================================================

# Supabase (duplica URL/anon porque código server-side não enxerga VITE_*)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service role key — DÁ ACESSO TOTAL AO BANCO. Nunca expor.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Bunny CDN (uploads/deletes proxy via /api/storage/*)
BUNNY_STORAGE_URL=https://ny.storage.bunnycdn.com/YOUR_STORAGE_ZONE
BUNNY_ACCESS_KEY=YOUR_BUNNY_STORAGE_KEY
BUNNY_CDN_URL=https://YOUR_PULL_ZONE.b-cdn.net


# =====================================================================
# OPCIONAL — só pra CLI/automações locais (não vai pra Vercel/runtime)
# =====================================================================

# Personal Access Token do Supabase (pra Management API / supabase CLI)
# SUPABASE_ACCESS_TOKEN=sbp_xxxxx

# Senha do banco Postgres (pra conexões diretas via psql)
# SUPABASE_DB_PASSWORD=xxxxx
